<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)..\'))" />
  <PropertyGroup>
    <RunAnalyzers>false</RunAnalyzers>

    <!-- https://github.com/dotnet/sdk/issues/37636 
    NU1903: known vulnerability in dependency warning doesn't make sense in test assets
    -->
    <NoWarn>$(NoWarn);NETSDK1188;NU1903</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Test Assets use the minimum supported versions -->
    <NETTestSdkMinimumVersion>16.5.0</NETTestSdkMinimumVersion>
    <XunitVersion>2.3.1</XunitVersion>
    <XunitTestAdapterVersion>2.3.1</XunitTestAdapterVersion>
    <XunitV3Version>2.0.0</XunitV3Version>
    <XunitV3TestAdapterVersion>3.0.2</XunitV3TestAdapterVersion>
    <NUnitVersion>3.13.2</NUnitVersion>
    <NUnitTestAdapterVersion>4.0.0</NUnitTestAdapterVersion>
    <MSTestVersion>3.0.4</MSTestVersion>
  </PropertyGroup>

  <!-- Default Configuration before composing paths below: Directory.Build.props is
       evaluated before the SDK applies its own Debug default, so $(Configuration)
       would otherwise freeze empty (explicit -c values arrive as global properties
       and are unaffected by this default). -->
  <PropertyGroup>
    <Configuration Condition="'$(Configuration)' == ''">Debug</Configuration>
  </PropertyGroup>

  <!-- Split intermediate and output paths per test runner flavor so VSTest and MTP
       restores/builds cannot observe each other's state (conditional PackageReferences
       differ per flavor, e.g. xunit 2.x vs xunit.v3). Mirrors src/Directory.Build.props. -->
  <PropertyGroup Condition="'$(IsMTP)' == 'true'">
    <BaseIntermediateOutputPath>obj\mtp\</BaseIntermediateOutputPath>
    <OutputPath>bin\$(Configuration)\mtp\</OutputPath>
    <DefaultItemExcludes>$(DefaultItemExcludes);obj\vstest\**</DefaultItemExcludes>
  </PropertyGroup>
  <PropertyGroup Condition="'$(IsMTP)' != 'true'">
    <BaseIntermediateOutputPath>obj\vstest\</BaseIntermediateOutputPath>
    <OutputPath>bin\$(Configuration)\vstest\</OutputPath>
    <DefaultItemExcludes>$(DefaultItemExcludes);obj\mtp\**</DefaultItemExcludes>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IsMTP)' == 'true'">
    <UsesXunit3>true</UsesXunit3>
    <DefineConstants>$(DefineConstants);USES_XUNIT3</DefineConstants>
    <EnableMSTestRunner>true</EnableMSTestRunner>
    <EnableNUnitRunner>true</EnableNUnitRunner>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <TestingPlatformCaptureOutput>false</TestingPlatformCaptureOutput>

    <!-- Need a combination with VSTestBridge >= 1.82.0 dependency -->
    <NUnitTestAdapterVersion>6.0.0</NUnitTestAdapterVersion>
    <MSTestVersion>4.0.0</MSTestVersion>
    <XunitV3Version>3.2.1</XunitV3Version>
    <XunitV3TestAdapterVersion>3.1.5</XunitV3TestAdapterVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Update="Stylecop.Analyzers" Version="1.2.0-beta.556" />
  </ItemGroup>
</Project>
<!-- vim: set ft=xml : -->
