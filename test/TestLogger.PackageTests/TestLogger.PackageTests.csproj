<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <WarningsAsErrors>true</WarningsAsErrors>
        <EnableCodeAnalysis>true</EnableCodeAnalysis>
        <IsPackable>false</IsPackable>
        <TestProject>true</TestProject>
        <OutputType>Exe</OutputType>
        <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
        <EnableMSTestRunner>true</EnableMSTestRunner>
    </PropertyGroup>

    <PropertyGroup>
        <DefineConstants Condition="$([MSBuild]::IsOSPlatform('Windows'))">WINDOWS_OS</DefineConstants>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="MSTest.TestFramework" />
        <PackageReference Include="MSTest.TestAdapter" />
        <PackageReference Include="Microsoft.Testing.Platform" />
        <PackageReference Include="Microsoft.Testing.Platform.MSBuild" />
        <PackageReference Include="Microsoft.Testing.Extensions.Telemetry" />
        <PackageReference Include="Microsoft.Testing.Extensions.TrxReport.Abstractions" />
        <PackageReference Include="Newtonsoft.Json" />
    </ItemGroup>

    <!-- Build test assets for acceptance tests -->
    <ItemGroup>
        <TestAssets Include="$(MSBuildThisFileDirectory)../assets/NUnit.Xml.PackageTest/NUnit.Xml.PackageTest.csproj" />
        <TestAssets Include="$(MSBuildThisFileDirectory)../assets/JUnit.Xml.PackageTest/JUnit.Xml.PackageTest.csproj" />
        <TestAssets Include="$(MSBuildThisFileDirectory)../assets/Xunit.Xml.PackageTest/Xunit.Xml.PackageTest.csproj" />
    </ItemGroup>
    <PropertyGroup>
        <TestRestoreConfig>$(MSBuildThisFileDirectory)../assets/NuGet.Release.config</TestRestoreConfig>
    </PropertyGroup>
    <PropertyGroup>
        <TestAssetProperties>PackageVersion=$(PackageVersion);RestoreConfigFile=$(TestRestoreConfig);RestoreNoCache=true</TestAssetProperties>
    </PropertyGroup>
    <ItemGroup>
        <TestAssetPurgeDirs Include="$(NuGetPackageRoot)/nunitxml.testlogger" />
        <TestAssetPurgeDirs Include="$(NuGetPackageRoot)/junitxml.testlogger" />
        <TestAssetPurgeDirs Include="$(NuGetPackageRoot)/xunitxml.testlogger" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="../TestLogger.Fixtures/TestLogger.Fixtures.csproj" />
    </ItemGroup>
  <Import Project="../TestAssets.targets" />
</Project>
